# ================================================================
#  RAAHI — environment template
#  Copy to .env and fill in. Every value here is a placeholder.
# ================================================================

# === Database ===
# TWO WAYS to connect. Uncomment ONE and delete the other.
#
# (A) SUPABASE (production / cloud — Mumbai region: ap-south-1)
#     Use the POOLER URL, not the direct one. The direct db.<ref>.supabase.co
#     endpoint is IPv6-only and hangs from most Indian ISPs / Windows machines.
#     Format:
#       postgresql://postgres.<PROJECT-REF>:<URL-ENCODED-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
#     Notes:
#       - user is 'postgres.<PROJECT-REF>' (NOT just 'postgres')
#       - port is 6543 (pooler), not 5432
#       - '@' in the password MUST be written as %40, ':' as %3A, '/' as %2F
#     Also fill SUPABASE_URL + keys (used by the Next.js dashboard).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key...
SUPABASE_ANON_KEY=eyJ...anon_key...
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:URL_ENCODED_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#
# (B) LOCAL DOCKER POSTGRES (dev only — spun up by docker-compose.yml)
#     Simpler / offline / faster. `run.bat` starts it for you.
#DATABASE_URL=postgresql://postgres:postgres@localhost:5432/raahi

# === Sarvam AI (STT + TTS + optional LLM) ===
SARVAM_API_KEY=sk_your_sarvam_key
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
# Assistant voice: a soft female voice. bulbul:v3 female speakers are
# priya, neha, pooja, simran, kavya, ishita, shreya, roopa, ritu.
# (anushka/vidya/manisha are bulbul:v2 names and are REJECTED by v3.)
# pace 1.0 is the voice's normal speed; it sounded slow on calls.
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_PACE=1.25
SARVAM_TTS_PAUSE_S=0.2
SARVAM_TTS_PITCH=0.0
SARVAM_TTS_TEMPERATURE=0.6
SARVAM_LLM_MODEL=sarvam-105b

# === Officer site (apps/web, /jobs) ===
# The access code district officers enter to add, edit or delete job
# openings. Leave unset to switch officer editing off. Pick a long random
# code and share it only with officers.
OFFICER_ACCESS_CODE=change-me

# === Extractor LLM — the model that turns speech into typed profile facts ===
# Recommended: `groq` — free tier, ~250 ms latency, https://console.groq.com/keys
# Options : mock | groq | gemini | grok | openai | anthropic | sarvam
EXTRACTOR_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROK_API_KEY=
GROK_MODEL=grok-3-mini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === IVR adapter (mock by default; twilio|exotel when ready for real calls) ===
IVR_PROVIDER=mock               # mock | twilio | exotel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_VIRTUAL_NUMBER=

# === WhatsApp adapter ===
WHATSAPP_PROVIDER=mock          # mock | meta
META_WABA_PHONE_ID=
META_WABA_TOKEN=

# === SMS provider ===
SMS_PROVIDER=mock

# === App tuning ===
APP_ENV=dev
LOG_LEVEL=INFO
INTERVIEW_MAX_TURNS=8
INTERVIEW_STABLE_TURNS=2
